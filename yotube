<?php
if ($_SERVER["REQUEST_METHOD"] == "POST" && !empty($_POST['youtube_links'])) {
    $links = explode("\n", trim($_POST['youtube_links']));
    $m3u_content = "#EXTM3U\n";

    foreach ($links as $link) {
        $link = trim($link);
        parse_str(parse_url($link, PHP_URL_QUERY), $queryParams);
        if (isset($queryParams['v'])) {
            $videoId = $queryParams['v'];
            $m3u_content .= "#EXTINF:-1, YouTube Video\n";
            $m3u_content .= "https://www.youtube.com/watch?v=$videoId\n";
        }
    }

    $filename = "youtube_playlist.m3u";
    header("Content-Type: audio/x-mpegurl");
    header("Content-Disposition: attachment; filename=$filename");
    echo $m3u_content;
    exit;
}
?>

